# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys or private URLs.
# `npm run setup` creates .env.local for you with generated secrets.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the built-in local database (PGlite),
# stored in ./.data/pglite. Set it to a Postgres URL when hosting.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# --- Sessions and webhooks --------------------------------------------------
# Long random strings. `npm run setup` generates these.
SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Public address of the app, used in customer links and emails.
APP_URL=http://localhost:3000

# --- AI drafting (optional) -------------------------------------------------
# Any OpenAI-compatible chat endpoint. Leave AI_API_KEY empty to use the
# built-in keyword matcher instead (no network calls, no cost).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5-nano
# The gateway caps output tokens; keep drafts small.
AI_MAX_TOKENS=400
